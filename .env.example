# Copy to .env and adjust. Every value here has a working default.

# Host ports. Change these only if something else on your machine already holds
# them — the containers talk to each other on the fixed ports inside the
# compose network regardless.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
API_PORT=8000

# How the backend reaches Neo4j *when run on the host* — `uv run pytest`, or
# `python -m graph.build.main` outside Docker. Must agree with
# NEO4J_BOLT_PORT above. Compose overrides this for the containers.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=futureco-local

# Optional. The knowledge graphs, concept resolver and safety filter are
# entirely deterministic and run without it.
# ANTHROPIC_API_KEY=
