# Copy to .env and adjust. Every value here has a working default.

# Host ports for the Neo4j container. Change these only if something else on
# your machine already holds 7474/7687.
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# How the backend reaches Neo4j. Must agree with NEO4J_BOLT_PORT above.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=futureco-local
